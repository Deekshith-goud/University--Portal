# ==============================================================================
# University Portal – Environment Variable Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — only commit this .env.example file.
# ==============================================================================

# --- Database ---
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=university_portal

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email (SMTP) ---
SMTP_USER=
SMTP_PASSWORD=
